YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret
YAHOO_REDIRECT_URI=https://localhost:3000/auth/callback
HOST=localhost
PORT=3000
YAHOO_REQUEST_TIMEOUT_MS=10000
YAHOO_REQUEST_RETRIES=2

# Optional MySQL activity logging
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=slackbrahs_logs
MYSQL_USER=slackbrahs_logs
MYSQL_PASSWORD=your-database-password
MYSQL_CONNECTION_LIMIT=5
SSL_CERT_FILE=.certs/localhost.crt
SSL_KEY_FILE=.certs/localhost.key
